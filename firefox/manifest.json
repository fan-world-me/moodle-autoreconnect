{
  "manifest_version": 2,
  "name": "Moodle Auto Relogin",
  "version": "1.2",
  "description": "Держить сесію на moodle.econom.zp.ua живою і автоматично логіниться, якщо сесія протухла",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "https://moodle.econom.zp.ua/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Moodle Auto Relogin",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.econom.zp.ua/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "moodle-relogin@yarik.local", "strict_min_version": "68.0" }
  }
}
